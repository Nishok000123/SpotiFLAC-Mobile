* text=auto eol=lf

# Scripts executed on Unix runners must keep LF line endings.
*.sh text eol=lf
gradlew text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Empty TSV fields and trailing lyric whitespace are intentional test data.
android/app/src/test/resources/lyrics_usability_cases.tsv whitespace=-blank-at-eol

# Retain upstream dependency sources for the Android compatibility patch.
rust_backend/vendor/** linguist-vendored
# Preserve the original whitespace in upstream license and policy documents.
rust_backend/vendor/rustix-1.1.4/LICENSE-Apache-2.0_WITH_LLVM-exception whitespace=-blank-at-eof
rust_backend/vendor/rustix-1.1.4/ORG_CODE_OF_CONDUCT.md whitespace=-blank-at-eol

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
*.aar binary
*.keystore binary
*.jks binary
